# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Server
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/incubrix_broll
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/incubrix_broll

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=incubrix-media
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Adapter Providers (mock | real)
STT_ADAPTER=mock
TTS_ADAPTER=mock
LLM_ADAPTER=mock
FOOTAGE_ADAPTER=mock
VISION_ADAPTER=mock

# External API Keys (optional if using mock adapters)
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENAI_API_KEY=

# Security & Webhook Signatures
CALLBACK_SECRET=incubrix_secret_dev_key_2026_super_secure

# Pipeline Heuristics
MIN_SCENE_DURATION_SECONDS=2.5
STOCK_SELECTION_THRESHOLD=0.28
MAX_AUDIO_DURATION_SECONDS=600
CACHE_DIR=/tmp/incubrix_cache
